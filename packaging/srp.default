# /etc/default/srp
#
# SSH Resilient Proxy 配置
#
# 最简用法：填入 SSH 目标即可工作。
# 私钥会自动从 ~/.ssh/ 中发现，无需额外指定。
#
# 编辑后执行 sudo systemctl restart srp 生效。
#
# 示例：
#   SRP_ARGS="alice@gateway.example.com"
#   SRP_ARGS="root@10.0.0.1 --socks5 0.0.0.0:1080 --http 0.0.0.0:8080"
#   SRP_ARGS="deploy@server --identity /root/.ssh/deploy_key --keepalive 10"

SRP_ARGS=""
